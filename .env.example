# ============================================================
# Divoom Times Gate widget framework (python -m divoom_widgets)
# Copy to .env and fill in. .env is gitignored.
# ============================================================

# --- Device ---
# IP of the Times Gate on your LAN (find it in the Divoom app, or it is
# reported by https://app.divoom-gz.com/Device/ReturnSameLANDevice).
DIVOOM_HOST=192.168.1.50

# --- Widgets ---
# Comma-separated widget:panel assignments (panels 1 = leftmost ... 5 = rightmost).
# Available widgets: claude_usage, codex_usage, energy.
WIDGETS=claude_usage:1
# Refresh intervals in seconds (min 15).
UPDATE_INTERVAL_SECONDS=300
ENERGY_INTERVAL_SECONDS=60
# Defaults to UPDATE_INTERVAL_SECONDS when unset.
# CODEX_INTERVAL_SECONDS=300

# --- Claude usage widget (Pro / Max consumer plan) ---
# No API or Admin key needed. The widget reads the OAuth access token that
# Claude Code already stores locally and calls the same endpoint /usage uses.
# Just be logged in to Claude Code (`claude` once). Override the path only if
# your credentials live somewhere non-standard:
# CLAUDE_CREDENTIALS_PATH=C:\Users\you\.claude\.credentials.json
#
# Headless / Docker: give the container its OWN Claude Code login and mount
# that credentials directory (see README "Deployment"). Do not copy the
# credentials of a machine you still use — both copies share one refresh
# token, so the first rotation kills the other.
#
# CLAUDE_CODE_OAUTH_TOKEN (`claude setup-token`) does NOT work for this
# widget: those tokens are inference-scoped, and the usage endpoint requires
# the user:profile scope, so it answers 403.

# --- Codex usage widget (ChatGPT / Codex plan, via SigNoz) ---
# Codex has no usage endpoint; the widget reads the newest token_count event
# of Codex session transcripts shipped into a SigNoz log store. The shipping
# collector must lift the plan fields into log attributes
# (codex.plan.used_percent / resets_at / window_minutes / plan_type and
# codex.timestamp) — see divoom_widgets/widgets/codex_usage.py.
# SIGNOZ_URL=http://signoz.local:8081
# SIGNOZ_API_KEY=
# ...or a file whose first non-empty line is the key:
# SIGNOZ_API_KEY_FILE=/run/secrets/signoz_api_key
# service.name the transcripts carry in the store.
# CODEX_SERVICE_NAME=codex-transcripts
# Oldest token_count event still considered (days).
# CODEX_LOOKBACK_DAYS=15

# --- Optional OTLP metrics ---
# Post every widget's numbers as OTLP/HTTP JSON gauges; empty = off.
# LO_ENDPOINT=http://otel-collector.local:4318
# LO_INGEST_TOKEN=
# LO_INGEST_TOKEN_FILE=/run/secrets/otlp_token
# LO_SERVICE_NAME=divoom-widgets

# --- Energy widget (Home Assistant) ---
# Long-lived access token: HA -> your profile -> Security -> Create Token.
# Give the widget its own token so it can be revoked independently.
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
# ...or point at a file whose first non-empty line is the token:
# HA_TOKEN_FILE=/run/secrets/ha_token
#
# Entity ids are installation-specific (find yours in HA under
# Developer Tools -> States; e.g. the Tesla Powerwall integration exposes
# load/solar power and battery charge sensors named after your gateway).
HA_ENTITY_LOAD=sensor.your_gateway_load_power
HA_ENTITY_SOLAR=sensor.your_gateway_solar_power
HA_ENTITY_SOC=sensor.your_gateway_charge
# Unit assumed for power entities if HA omits unit_of_measurement (kW or W).
HA_POWER_UNIT=kW

# --- GitHub Copilot (legacy provider; not wired to a widget yet) ---
# Requires a GitHub App user-to-server OAuth token (gho_/ghu_) with the user
# "Plan" permission. Classic and fine-grained PATs do NOT work for the personal
# billing endpoint. Mint/refresh one with: node scripts/get-github-token.mjs <APP_CLIENT_ID>
# (App tokens expire ~8h unless your App disables expiration.)
GITHUB_OAUTH_TOKEN=
GITHUB_USERNAME=
# Used as the denominator when the API does not report an included amount
# (Copilot Pro legacy = 300 premium requests/month).
COPILOT_MONTHLY_QUOTA=300

# --- Container healthcheck ---
# Heartbeat file the loop touches after each fully successful cycle.
# HEARTBEAT_FILE=/tmp/heartbeat
# How stale it may get before the healthcheck fails; 0 = 3x the slowest
# widget interval. The healthcheck also probes the device itself.
# HEARTBEAT_MAX_AGE_SECONDS=0
