# ============================================================
# Divoom Times Gate usage widget (python -m usage_widget)
# Copy to .env and fill in. .env is gitignored.
# ============================================================

# --- Device ---
# IP of the Times Gate on your LAN (find it in the Divoom app, or it is
# reported by https://app.divoom-gz.com/Device/ReturnSameLANDevice).
DIVOOM_HOST=192.168.1.50
# Which of the five LCD panels to draw on (1 = leftmost ... 5 = rightmost).
WIDGET_PANEL=1
# Refresh interval in seconds (min 15). Claude usage updates ~every few minutes.
UPDATE_INTERVAL_SECONDS=300

# --- Claude (Pro / Max consumer plan) ---
# No API or Admin key needed. The widget reads the OAuth access token that
# Claude Code already stores locally and calls the same endpoint /usage uses.
# Just be logged in to Claude Code (`claude` once). Override the path only if
# your credentials live somewhere non-standard:
# CLAUDE_CREDENTIALS_PATH=C:\Users\you\.claude\.credentials.json
#
# Headless / Docker: instead of the credentials file, set a long-lived token
# from `claude setup-token` (no Claude Code install needed at runtime):
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# --- GitHub Copilot (individual Pro) ---
# Requires a GitHub App user-to-server OAuth token (gho_/ghu_) with the user
# "Plan" permission. Classic and fine-grained PATs do NOT work for the personal
# billing endpoint. Mint/refresh one with: node scripts/get-github-token.mjs <APP_CLIENT_ID>
# (App tokens expire ~8h unless your App disables expiration.)
GITHUB_OAUTH_TOKEN=
GITHUB_USERNAME=
# Used as the denominator when the API does not report an included amount
# (Copilot Pro legacy = 300 premium requests/month).
COPILOT_MONTHLY_QUOTA=300
